# Copy this file to .env.local and fill it in. Never commit .env.local.

# Supabase: Project Settings > API Keys, and the Project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio: https://aistudio.google.com/apikey (the free tier is enough)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: which Gemini model the AI pre-review uses
GEMINI_MODEL=gemini-3.1-flash-lite

# Any 32+ random characters, e.g. the output of: openssl rand -hex 32
IP_HASH_SALT=

# Optional Cloudflare Turnstile ("are you human?" check) on the submission form
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

SUBMISSIONS_PER_DAY=3
